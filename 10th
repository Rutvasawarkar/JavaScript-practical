<html>
<head>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>
<h3>Student Data</h3>
<button onclick="loadFetch()">Fetch Data</button>
<button onclick="loadJQuery()">jQuery Data</button>
<table border="1" id="t"></table>

<script>
function show(data) {
    t.innerHTML = "<tr><th>ID</th><th>Name</th><th>Email</th></tr>";
    data.forEach(x => {
        t.innerHTML += `<tr><td>${x.id}</td>
        <td>${x.name}</td><td>${x.email}</td></tr>`;
    });
}

function loadFetch() {
    fetch("https://jsonplaceholder.typicode.com/users")
    .then(res => res.json())
    .then(data => show(data));
}

function loadJQuery() {
    $.getJSON("https://jsonplaceholder.typicode.com/users",
        data => show(data));
}
</script>
</body>
</html>
