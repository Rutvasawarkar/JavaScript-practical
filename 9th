<html>
<body id="page">
<h3>Theme Settings</h3>

<h4>localStorage</h4>
<button onclick="setLocal('light')">Light</button>
<button onclick="setLocal('dark')">Dark</button>

<h4>sessionStorage</h4>
<button onclick="setSession('light')">Light</button>
<button onclick="setSession('dark')">Dark</button>

<p id="msg"></p>

<script>
function apply(t) {
    page.style.background = t == "dark" ? "black" : "white";
    page.style.color = t == "dark" ? "white" : "black";
}

function setLocal(t) {
    localStorage.setItem("theme", t);
    sessionStorage.removeItem("theme");
    apply(t);
    msg.innerHTML = "Theme saved in localStorage";
}

function setSession(t) {
    sessionStorage.setItem("theme", t);
    apply(t);
    msg.innerHTML = "Theme saved in sessionStorage";
}

window.onload = function() {
    apply(sessionStorage.getItem("theme") ||
          localStorage.getItem("theme") || "light");
};
</script>
</body>
</html>
